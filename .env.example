# Rakendus (brauser). Kõik VITE_ muutujad jõuavad bundle'isse – siia ainult
# avalikud võtmed. Kopeeri .env.local failiks ja täida päris väärtustega.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Ainult skriptidele (npm run sync-modules), MITTE brauserile. Service-võti
# käib RLS-ist mööda – ta ei tohi kunagi saada VITE_ eesliidet ega git'i.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Vabatahtlik, ainult TOODANGU keskkonda (Cloudflare → Build → Production).
# Mõlemad on avalikud märgised, mitte saladused – aga arenduses jäta tühjaks,
# muidu läheb iga sinu katsetuse viga päris statistikasse.
# Sentry DSN: sentry.io → Settings → Projects → <projekt> → Client Keys
VITE_SENTRY_DSN=
# Cloudflare Web Analytics token: dash.cloudflare.com → Analytics →
# Web Analytics → Add a site → „Manual installation" alt JS-lõigust
VITE_CF_ANALYTICS_TOKEN=
